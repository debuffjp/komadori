{
  "name": "komadori",
  "version": "0.1.2",
  "description": "Step a web page one frame at a time, check every frame, and make a clip: 10 s of a million boids at 1080p in 11-14 s. Works with any canvas engine.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "komadori": "bin/komadori.mjs",
    "komadori-mcp": "bin/komadori-mcp.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debuffjp/komadori.git"
  },
  "keywords": [
    "spryte",
    "canvas",
    "webgl",
    "render",
    "contact-sheet",
    "mp4",
    "frame-by-frame",
    "agent",
    "playwright"
  ],
  "homepage": "https://github.com/debuffjp/komadori#readme",
  "bugs": {
    "url": "https://github.com/debuffjp/komadori/issues"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
