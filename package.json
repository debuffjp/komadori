{
  "name": "komadori",
  "version": "0.0.0",
  "description": "Steps a browser scene frame by frame, checks the frames, and writes a contact sheet, a report and an mp4. Made for spryte scenes, works with any canvas engine.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "komadori": "bin/komadori.mjs",
    "komadori-mcp": "bin/komadori-mcp.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debuffjp/komadori.git"
  },
  "keywords": [
    "spryte",
    "canvas",
    "webgl",
    "render",
    "contact-sheet",
    "mp4",
    "frame-by-frame",
    "agent",
    "playwright"
  ],
  "homepage": "https://github.com/debuffjp/komadori#readme",
  "bugs": {
    "url": "https://github.com/debuffjp/komadori/issues"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
